# Copy to .env for local dev. .env is gitignored — never commit real values.

# ---- Authentication provider (srv/auth.js selector) ----
# Unset or "local" -> email/password + HS256 JWT (srv/auth/local-auth.js).
# "cognito"         -> AWS Cognito (srv/auth/cognito-auth.js).
# Local dev leaves this unset. Only set it to test the Cognito flow locally.
# AUTH_PROVIDER=local

# Required only when AUTH_PROVIDER=cognito:
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=          # empty for a public app client (recommended)
# AWS_REGION=                     # = COGNITO_REGION; for the Admin* API calls
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Local auth provider (ignored when AUTH_PROVIDER=cognito) ----
# Required for the local provider. Long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

JWT_ISSUER=itsm
JWT_AUDIENCE=itsm-app
JWT_ACCESS_TOKEN_EXPIRY=8h

# Base URL the UI5 app is served from — used to build password setup/reset links.
APP_URL=http://localhost:4004/webapp

# Password setup, reset and ticket notification emails. Without SMTP_HOST the
# password link is printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
