# ITSM production environment — TEMPLATE
#
# On the server:
#   sudo mkdir -p /etc/itsm
#   sudo cp deploy/itsm.env.example /etc/itsm/itsm.env
#   sudo chown root:itsm /etc/itsm/itsm.env
#   sudo chmod 640 /etc/itsm/itsm.env
#   sudo nano /etc/itsm/itsm.env      # fill in the blanks below
#
# NEVER commit the filled-in file. This template stays in git; /etc/itsm/itsm.env does not.

# ---- Runtime ----
NODE_ENV=production
PORT=4004

# ---- Authentication provider (srv/auth.js selector) ----
# "local"   = email/password + HS256 JWT   (srv/auth/local-auth.js)
# "cognito" = AWS Cognito                    (srv/auth/cognito-auth.js)
# Switching is just this var + `sudo systemctl restart itsm`. Rollback = set
# back to local + restart. See deploy/DEPLOYMENT.md §4A.
AUTH_PROVIDER=local

# ---- Cognito (required only when AUTH_PROVIDER=cognito) ----
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Empty for a public app client (recommended). Set only if it has a secret.
COGNITO_CLIENT_SECRET=

# AWS credentials for the Admin* Cognito calls (create user, sync groups,
# enable/disable). Lightsail has no instance role, so these are explicit.
# Login / token verify / forgot-password need NO credentials.
# Least-privilege IAM policy: deploy/DEPLOYMENT.md §4A.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Local auth provider (ignored when AUTH_PROVIDER=cognito) ----
# REQUIRED for the local provider — the server refuses to start in production
# without it. Generate ON THE SERVER, once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later logs every user out on the next restart.
JWT_SECRET=

JWT_ISSUER=itsm
JWT_AUDIENCE=itsm-app
JWT_ACCESS_TOKEN_EXPIRY=8h

# Public base URL the UI5 app is served from. Password setup/reset links are
# built from this (local provider only), so it must be reachable from a user's
# browser and must end in /webapp. HTTP + IP for milestone 1; switch to
# https://<domain> later.
APP_URL=http://3.111.154.43/webapp

# ---- PostgreSQL (@cap-js/postgres) ----
# CAP maps CDS_REQUIRES_DB_CREDENTIALS_* onto cds.requires.db.credentials.*
# Postgres runs on this same box, bound to loopback only.
CDS_REQUIRES_DB_CREDENTIALS_HOST=127.0.0.1
CDS_REQUIRES_DB_CREDENTIALS_PORT=5432
CDS_REQUIRES_DB_CREDENTIALS_DATABASE=itsm
CDS_REQUIRES_DB_CREDENTIALS_USER=itsm_app
CDS_REQUIRES_DB_CREDENTIALS_PASSWORD=

# ---- Email — intentionally UNSET for now ----
# With no SMTP_HOST, srv/auth.js prints the password setup/reset link to
# `journalctl -u itsm` instead of sending it. Wire these up separately later.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
