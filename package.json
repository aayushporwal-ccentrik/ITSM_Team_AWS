{
  "name": "ITSM",
  "version": "1.0.0",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1121.0",
    "@cap-js/hana": "^2",
    "@cap-js/postgres": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "aws-jwt-verify": "^5.2.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.3",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db/itsm.sqlite"
          }
        }
      },
      "auth": {
        "kind": "custom",
        "impl": "srv/auth.js"
      },
      "[hybrid]": {
        "db": "hana"
      },
      "[production]": {
        "db": {
          "kind": "postgres",
          "impl": "@cap-js/postgres",
          "pool": {
            "max": 8,
            "min": 0
          }
        }
      },
      "db": "hana"
    }
  }
}
