{
  "_version": "1.40.0",
  "sap.app": {
    "id": "itsm.ui",
    "type": "application",
    "title": "ITSM - New Incident",
    "dataSources": {
      "incidentService": {
        "uri": "/odata/v4/ITSMService/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "applicationVersion": { "version": "1.0.0" },
    "crossNavigation": {
      "inbounds": {
        "itsm-manage": {
          "semanticObject": "ITSMTicket",
          "action": "manage",
          "title": "ITSM Service Desk",
          "subTitle": "Manage IT service tickets",
          "icon": "sap-icon://it-instance",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "ITSM"
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "itsm.ui.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
  "sap.m": {},
  "sap.ui.core": {},
  "sap.ui.unified": {},
  "sap.viz": {}
}
    },
    "models": {
      "": {
        "dataSource": "incidentService",
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": false,
          "groupId": "$auto",
          "updateGroupId": "incidentGroup"
        }
      }
    },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "itsm.ui.view",
        "controlId": "app",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
  { "pattern": "login", "name": "login", "target": "login" },
  { "pattern": "forgot-password", "name": "forgotPassword", "target": "login" },
  { "pattern": "reset-password/{token}", "name": "resetPassword", "target": "login" },
  { "pattern": "select-role", "name": "selectRole", "target": "selectRole" },
  { "pattern": "", "name": "dashboard", "target": "dashboard" },
  { "pattern": "service-group-dashboard", "name": "serviceGroupDashboard", "target": "serviceGroupDashboard" },
  { "pattern": "create", "name": "create", "target": "main" },
  { "pattern": "ticket/{id}", "name": "detail", "target": "main" },
  { "pattern": "assigned", "name": "assigned", "target": "assigned" },
  { "pattern": "organizations", "name": "organizations", "target": "organizations" },
  { "pattern": "organizations/{id}", "name": "organizationDetail", "target": "organizationDetail" }
],
"targets": {
  "login": { "viewName": "Login", "viewId": "login" },
  "selectRole": { "viewName": "RoleSelection", "viewId": "selectRole" },
  "dashboard": { "viewName": "Dashboard", "viewId": "dashboard" },
  "serviceGroupDashboard": { "viewName": "ServiceGroupDashboard", "viewId": "serviceGroupDashboard" },
  "main": { "viewName": "Main", "viewId": "main" },
  "assigned": { "viewName": "AssignedTickets", "viewId": "assigned" },
  "organizations": { "viewName": "Organizations", "viewId": "organizations" },
  "organizationDetail": { "viewName": "OrganizationDetail", "viewId": "organizationDetail" }
}
    }
  }
}
